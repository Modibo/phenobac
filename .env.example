# PhénoBac — variables d'environnement.
# Copiez ce fichier en .env, renseignez les valeurs, puis : chmod 600 .env
# NE VERSIONNEZ JAMAIS .env (il est déjà exclu par .gitignore).

# --- Secrets (obligatoires) ----------------------------------------------
# Signature des licences. Le changer invalide TOUTES les licences émises.
#   openssl rand -hex 32
PHENOBAC_SECRET=

# Jeton d'administration : émission de licences, révocation, statistiques.
#   openssl rand -hex 32
PHENOBAC_ADMIN_TOKEN=

# Secret partagé avec le prestataire de paiement, pour authentifier son webhook.
#   openssl rand -hex 24
PHENOBAC_WEBHOOK_SECRET=

# --- Site -----------------------------------------------------------------
# URL publique, sans barre oblique finale. Sert aux SMS et au verrouillage CORS.
SITE_URL=https://phenobac.votre-domaine.ovh

# Origines autorisées à appeler l'API, séparées par des virgules.
# Vide = repli sur SITE_URL. La valeur "*" ouvre l'API à tous : à éviter en production.
ALLOWED_ORIGINS=

# Durée (heures) pendant laquelle une clé reste récupérable sur success.html
# avec la seule référence de paiement. Défaut 48.
CLAIM_WINDOW_HOURS=48

# --- Stockage -------------------------------------------------------------
STORE_BACKEND=file
DATA_DIR=/data
PORT=8080

# --- Passerelle SMS (facultative) ----------------------------------------
# Sans ces valeurs, la clé n'est pas envoyée par SMS : le client la récupère
# sur success.html grâce à sa référence de paiement.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=PhenoBac
