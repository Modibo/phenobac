# PhénoBac — variables d'environnement.
# Copiez ce fichier en .env, renseignez les valeurs, puis : chmod 600 .env
# NE VERSIONNEZ JAMAIS .env (il est déjà exclu par .gitignore).

# --- Secrets (obligatoires) ----------------------------------------------
# Signature des licences. Le changer invalide TOUTES les licences émises.
#   openssl rand -hex 32
PHENOBAC_SECRET=

# Jeton d'administration : émission de licences, révocation, statistiques.
#   openssl rand -hex 32
PHENOBAC_ADMIN_TOKEN=

# Secret partagé avec le prestataire de paiement, pour authentifier son webhook.
#   openssl rand -hex 24
PHENOBAC_WEBHOOK_SECRET=

# --- Site -----------------------------------------------------------------
# URL publique, sans barre oblique finale. Sert aux SMS et au verrouillage CORS.
SITE_URL=https://phenobac.votre-domaine.ovh

# Origines autorisées à appeler l'API, séparées par des virgules.
# Vide = repli sur SITE_URL. La valeur "*" ouvre l'API à tous : à éviter en production.
ALLOWED_ORIGINS=

# Durée (heures) pendant laquelle une clé reste récupérable sur success.html
# avec la seule référence de paiement. Défaut 48.
CLAIM_WINDOW_HOURS=48

# --- Stockage -------------------------------------------------------------
STORE_BACKEND=file
DATA_DIR=/data
PORT=8080

# --- Connecteur du prestataire de paiement --------------------------------
# Détail complet et procédure de calibrage : lib/psp.js et MISE-EN-VENTE.md § 2.

# Profil du prestataire : paydunya | generic
# Un profil ne fait que fournir des valeurs par défaut. Toute variable WEBHOOK_*
# renseignée ci-dessous l'emporte sur lui.
PSP=paydunya

# --- PayDunya (si PSP=paydunya) -------------------------------------------
# Clés du tableau de bord PayDunya. Elles servent à RECONFIRMER la facture
# auprès de PayDunya : c'est cette réponse qui fait foi, pas le contenu de l'IPN.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test = sandbox (aucun argent réel), live = production.
PAYDUNYA_MODE=test

# Comment le prestataire prouve que l'appel vient bien de lui :
#   token    jeton partagé dans un en-tête          (le plus simple)
#   hmac     il signe le corps de la requête        (résiste au rejeu modifié)
#   confirm  on rappelle son API pour vérifier      (le plus sûr)
WEBHOOK_AUTH=token

# En-tête portant le jeton (mode token) ou la signature (mode hmac).
WEBHOOK_AUTH_HEADER=x-webhook-token

# Mode hmac uniquement :
WEBHOOK_HMAC_ENCODING=hex
WEBHOOK_HMAC_PREFIX=

# Mode confirm uniquement — {ref} est remplacé par la référence de paiement :
WEBHOOK_CONFIRM_URL=
WEBHOOK_CONFIRM_AUTH=
WEBHOOK_CONFIRM_STATUS=
WEBHOOK_CONFIRM_AMOUNT=

# Emplacement des champs, si les noms usuels ne suffisent pas (chemins pointés,
# ex. data.invoice.token). À laisser vide tant que le décodage fonctionne.
WEBHOOK_FIELD_STATUS=
WEBHOOK_FIELD_AMOUNT=
WEBHOOK_FIELD_REF=
WEBHOOK_FIELD_CONTACT=

# Valeurs de statut signifiant « payé », séparées par des virgules.
# Vide = liste par défaut (success, completed, paid, accepted, 00, 1, true…).
WEBHOOK_SUCCESS_VALUES=

# Journalise le webhook reçu, pour le calibrage. À ÉTEINDRE ensuite : ces
# journaux contiennent les coordonnées du payeur.
PHENOBAC_WEBHOOK_DEBUG=0

# --- Passerelle SMS (fortement recommandée) --------------------------------
# Sans ces valeurs, la clé n'est pas envoyée par SMS : le client la récupère
# sur success.html grâce à sa référence de paiement — cela marche, mais chaque
# friction coûte des ventes. Détail : lib/deliver.js, MISE-EN-VENTE.md § 3.

# Profil : twilio | africastalking | generic
# Un profil ne fournit que des valeurs par défaut ; toute variable SMS_*
# renseignée ci-dessous l'emporte sur lui.
SMS_PROFILE=generic

SMS_API_URL=
SMS_API_KEY=
SMS_API_USER=
SMS_SENDER=PhenoBac

# Forme de l'appel, si le profil générique ne convient pas :
SMS_METHOD=POST            # POST | GET
SMS_BODY_FORMAT=json       # json | form | query
SMS_AUTH=bearer            # bearer | basic | header | none
SMS_AUTH_HEADER=

# Noms des champs attendus par la passerelle :
SMS_FIELD_TO=to
SMS_FIELD_FROM=from
SMS_FIELD_TEXT=message

# Champs supplémentaires exigés par certaines passerelles, en JSON.
SMS_EXTRA=

# Certaines passerelles répondent 200 en signalant l'échec dans le corps :
# indiquez un fragment de texte présent uniquement en cas de succès.
SMS_SUCCESS_MATCH=

# Indicatif ajouté aux numéros locaux (Mali : +223).
SMS_COUNTRY_CODE=+223

# "1" : construit et journalise le SMS sans rien envoyer. Pour calibrer sans
# consommer de crédits. À remettre à 0 ensuite.
SMS_DRY_RUN=0
